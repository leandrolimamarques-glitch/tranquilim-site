{
  "name": "tranquilim-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:servidor": "tsx server/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vitest run && vite build && npm run build:servidor",
    "build:servidor": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "build:producao": "vite build && npm run build:servidor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "2.4.3",
    "express": "4.21.2",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "postgres": "3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
